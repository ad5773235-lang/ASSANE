# Assane AI backend
ASSANE_ENV=development
ASSANE_HOST=0.0.0.0
ASSANE_PORT=8000
ASSANE_DATA_DIR=./backend
# En dehors de Docker, SQLite reste le mode développement par défaut.
# Docker Compose configure PostgreSQL si ASSANE_DATABASE_URL n’est pas remplacée.
ASSANE_DATABASE_URL=sqlite:///./backend/assane.db
ASSANE_JWT_SECRET=replace-with-a-long-random-secret
ASSANE_OWNER_NAME=Assane Moussa Goudiaby
ASSANE_OWNER_BIRTH_DATE=22/10/2008
ASSANE_OWNER_LOCATION=Sénégal, région de Dakar, département de Keur Massar, ville de Plan Jaxaay
ASSANE_CORS_ORIGINS=*

# URL publique du backend et des aperçus.
# En production, renseigner une vraie URL HTTPS, par exemple votre domaine réel.
# Ne mettez jamais de clé fournisseur dans l’APK.
ASSANE_PUBLIC_BASE_URL=
# URL utilisée par le build Android release via -PassaneBackendUrl ou ASSANE_API_URL.
ASSANE_API_URL=
# Variables PostgreSQL utilisées par docker-compose (remplacez le mot de passe local).
POSTGRES_DB=assane
POSTGRES_USER=assane
POSTGRES_PASSWORD=replace-with-a-local-password

# Manus API
MANUS_API_KEY=
MANUS_API_BASE_URL=https://open.manus.ai

# GitHub REST API — dépôt explicite autorisé pour les publications confirmées
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
GITHUB_API_BASE_URL=https://api.github.com

# Mistral API
MISTRAL_API_KEY=
MISTRAL_API_BASE_URL=https://api.mistral.ai
MISTRAL_MODEL=mistral-large-latest

# Vercel API
VERCEL_TOKEN=
VERCEL_API_BASE_URL=https://api.vercel.com
VERCEL_TEAM_ID=

# Cloudflare Pages API — projet Direct Upload déjà créé et autorisé
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_ACCOUNT_ID=ea5d6301629777f16b3d813e39915215
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_PAGES_BRANCH=main
CLOUDFLARE_WORKER_NAME=
CLOUDFLARE_WORKER_URL=

# Google Play Developer API — fichier JSON uniquement sur le serveur
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_TRACK=internal

# OpenAI API
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_AUDIO_MODEL=gpt-4o-mini-tts

# Stability AI
STABILITY_API_KEY=	
STABILITY_API_BASE_URL=https://api.stability.ai

# Deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_API_BASE_URL=https://api.deepgram.com

# En production, utiliser ASSANE_ENV=production, un secret aléatoire,
# une URL HTTPS publique, une liste CORS explicite et ASSANE_RUNNER_MODE=docker.
# Optional runner configuration
ASSANE_RUNNER_MODE=local
ASSANE_DOCKER_IMAGE=assane/android-builder:2026-08
ASSANE_ANDROID_CONNECTED_TESTS=false
ASSANE_MAX_ITERATIONS=24
ASSANE_TASK_TIMEOUT_SECONDS=1200
ASSANE_MAX_UPLOAD_BYTES=52428800
ASSANE_MAX_USER_STORAGE_BYTES=524288000
ASSANE_MAX_PREVIEW_BYTES=262144000

# Authentification OTP SMS — logique contrôlée par Assane AI
# development n’envoie aucun SMS réel ; unimatrix envoie les OTP via l’API Unimatrix.
ASSANE_SMS_PROVIDER=development
ASSANE_SMS_LOG_OTP=false
ASSANE_SMS_API_URL=
ASSANE_SMS_API_TOKEN=
# Unimatrix : AccessKey ID et, si le mode HMAC est activé dans la console,
# AccessKey Secret. Ne jamais mettre ces valeurs dans l’APK.
UNIMATRIX_BASE_URL=https://api.unimtx.com
UNIMATRIX_ACCESS_KEY_ID=
UNIMATRIX_ACCESS_KEY_SECRET=
UNIMATRIX_AUTH_MODE=simple
UNIMATRIX_TIMEOUT_SECONDS=15
ASSANE_OTP_EXPIRY_SECONDS=300
ASSANE_OTP_MAX_ATTEMPTS=5
ASSANE_OTP_RESEND_COOLDOWN_SECONDS=60
ASSANE_OTP_MAX_REQUESTS_PER_HOUR=5
